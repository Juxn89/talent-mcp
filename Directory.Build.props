<Project>
  <!--
    Repo-wide build properties. Package VERSIONS live in Directory.Packages.props
    (Central Package Management) — not here. See the comment in that file for why.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Package metadata -->
    <!--
      Repo-wide default version. The two PUBLISHED packages (Talent.Mcp.Toolkit and
      Talent.Mcp.Server) override it in their own .csproj, so the library can take a
      breaking change without dragging the dotnet tool to a major it did not earn.

      These properties must NOT go in Directory.Packages.props: that file is imported
      *after* this one, so a value there silently wins. It did — it carried 1.0.1 while
      this file said 1.0.0, which is how v1.0.2 through v1.0.5 all shipped stamped 1.0.1.
      Corrected in F6.
    -->
    <Version>1.0.5</Version>
    <Authors>Juan Gómez</Authors>
    <PackageProjectUrl>https://github.com/Juxn89/talent-mcp</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Juxn89/talent-mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Build gates: analyzer and naming violations fail the build, they do not warn -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      Publishing quality, for the two packages that ship. Each of these is baked into the .nupkg, so
      adding one later costs a version bump that exists only to fix metadata.

      PublishRepositoryUrl + EmbedUntrackedSources enable SourceLink, which since .NET 8 is part of
      the SDK rather than a separate package. With the symbol package that follows, a consumer can
      step from their own code into this library's source at the exact commit.

      IncludeSymbols with SymbolPackageFormat=snupkg produces the companion symbol package NuGet.org
      accepts. `dotnet nuget push` uploads a .snupkg sitting beside its .nupkg automatically, so
      publish.yml needs no change.
    -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReleaseNotes>https://github.com/Juxn89/talent-mcp/blob/main/CHANGELOG.md</PackageReleaseNotes>

    <!-- Deterministic builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    Test-project overrides live in tests/Directory.Build.props, NOT here.
    `IsTestProject` is set by Microsoft.NET.Test.Sdk, which is a PackageReference in the project
    body — and this file is imported *before* the body, so a `Condition="'$(IsTestProject)' == 'true'"`
    PropertyGroup here can never fire. Same import-ordering trap as `PackageReference Update=`
    (NU1015). MSBuild picks the nearest Directory.Build.props walking up, so tests/ has its own,
    which imports this one and then adds what it needs.
  -->

  <ItemGroup>
    <CompilerVisibleProperty Include="CI" />
  </ItemGroup>
</Project>
