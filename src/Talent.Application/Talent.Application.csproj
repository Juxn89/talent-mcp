<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Talent.Application</RootNamespace>
    <Description>Use cases and ports (repository and codec interfaces). References Talent.Domain only.</Description>
    <!--
      Turns on the trim, AOT and single-file analyzers together and marks the assembly
      IsTrimmable. Combined with the repo-wide TreatWarningsAsErrors, any newly introduced
      reflection-based serialization site becomes a build error rather than a warning nobody
      reads — which is what ADR-0002's consequences section asked CI to catch.
    -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Talent.Domain/Talent.Domain.csproj" />
  </ItemGroup>
</Project>
