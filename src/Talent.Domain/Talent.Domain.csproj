<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Talent.Domain</RootNamespace>
    <Description>Recruitment domain: entities, enums, and the pure scoring and skill-normalization functions. No framework dependencies.</Description>
    <!--
      Turns on the trim, AOT and single-file analyzers together and marks the assembly
      IsTrimmable. Combined with the repo-wide TreatWarningsAsErrors, any newly introduced
      reflection-based serialization site becomes a build error rather than a warning nobody
      reads — which is what ADR-0002's consequences section asked CI to catch.
    -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <!--
    Deliberately EMPTY of PackageReference items. Talent.Domain knows nobody: no EF Core, no MCP
    SDK, no ASP.NET. Talent.Architecture.Tests fails the build if that changes.
  -->
</Project>
