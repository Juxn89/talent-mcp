<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Talent.Infrastructure</RootNamespace>
    <Description>Adapters implementing the Application ports: EF Core/Npgsql persistence, migrations and seeds.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Talent.Application/Talent.Application.csproj" />
    <ProjectReference Include="../Talent.Mcp.Toolkit/Talent.Mcp.Toolkit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
