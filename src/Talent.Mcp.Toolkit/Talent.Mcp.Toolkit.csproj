<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Talent.Mcp.Toolkit</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Talent.Mcp.Toolkit</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--
      Compares this package's public API against the last published version at pack time and fails
      the build on an unintended break. Added because F6 verified "no breaking change" by diffing XML
      documentation by hand, which was correct but is not a method that scales past the person who
      remembers to run it. The baseline is 1.0.1 because that is the only version that ever reached
      nuget.org; v1.0.2 through v1.0.5 exist as tags but published nothing.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.1</PackageValidationBaselineVersion>
    <!--
      Local/default version only. CI derives the PUBLISHED version from the git tag
      (publish.yml passes -p:Version), so a release puts both packages at the tag's version.
      That is lockstep on purpose for now: one tag, one release.

      This property still exists per project rather than only repo-wide so that the day the
      library needs a major the tool has not earned, the divergence has somewhere to live —
      it would need package-scoped tags in publish.yml to actually ship, which is the change
      to make at that point and not before.
    -->
    <Version>1.1.0</Version>
    <Description>Domain-agnostic Model Context Protocol primitives for the 2026-07-28 revision: signed TTL-bounded handles, cache policies, a Postgres task store, and OpenTelemetry context extraction from _meta.</Description>
    <PackageProjectUrl>https://github.com/Juxn89/talent-mcp</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>mcp;model-context-protocol;protocol-primitives;tasks;oauth2;ai-tooling</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      Restored once HandleCodec gained JsonTypeInfo overloads. The claim is honest now: the two
      reflective paths that remain are the [Obsolete] overloads, and they carry
      [RequiresUnreferencedCode]/[RequiresDynamicCode] rather than a #pragma. That distinction is the
      whole point — a suppression hid the warning from CONSUMERS trimming their own applications
      (measured: 4 diagnostics without it, 0 with), while an annotation pushes it to whoever actually
      calls the obsolete overload, which is where the decision belongs. See ADR-0007.
    -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <!--
    NO ProjectReference to Talent.Domain. This ships to NuGet as a reusable protocol library, so no
    recruitment concept may leak into it. Talent.Architecture.Tests enforces that.
  -->
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="ModelContextProtocol.Extensions.Tasks" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
